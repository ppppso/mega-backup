{
  "mega_remote_path":   {"type": "string", "default": "",      "pattern": "^(/.*)?$"},
  "backup_time":        {"type": "string", "default": "03:30", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
  "keep_daily":         {"type": "int",    "default": 90,      "min": 1, "max": 100000},
  "keep_monthly":       {"type": "int",    "default": 24,      "min": 0, "max": 100000},
  "max_drop_percent":   {"type": "int",    "default": 20,      "min": 0, "max": 100},
  "max_change_percent": {"type": "int",    "default": 20,      "min": 0, "max": 100},
  "check_weekday":      {"type": "int",    "default": 7,       "min": 0, "max": 7},
  "check_read_percent": {"type": "int",    "default": 5,       "min": 0, "max": 100},
  "healthcheck_url":    {"type": "string", "default": "",      "pattern": "^(https?://[^\\s\"'\\\\]+)?$"},
  "backup_on_start":    {"type": "bool",   "default": false},
  "allow_nonempty_init":{"type": "bool",   "default": false},
  "restic_password_saved": {"type": "bool", "default": false}
}
