# Copy to .env and edit. Keep comments on their own lines
# (a comment after an empty value becomes the value).

# Folder in your MEGA account to back up (absolute MEGA path, e.g. /Backup/Photos).
# Leave empty to pick it on the web page's Setup page.
MEGA_REMOTE_PATH=

# Host paths. Check these on your Umbrel (see README "Paths on Umbrel").
# CONFIG_DIR holds the MEGA session and the restic password: keep it private!
CONFIG_DIR=./config
SYNC_DIR=/home/umbrel/umbrel/home/mega-backup/current
REPO_DIR=/home/umbrel/umbrel/home/mega-backup/repo
RESTORE_DIR=/home/umbrel/umbrel/home/mega-backup/restore

PUID=1000
PGID=1000
# Your timezone, e.g. Europe/Madrid
TZ=UTC

# Daily backup time, HH:MM in TZ.
BACKUP_TIME=03:30
# Keep the last N daily snapshots, plus one per month for N months.
KEEP_DAILY=90
KEEP_MONTHLY=24
# If more than this % of files are removed / changed since the previous backup:
# alert, and stop pruning until you check (see README "Prune hold").
MAX_DROP_PERCENT=20
MAX_CHANGE_PERCENT=20
# Weekly repository check: day (1=Mon ... 7=Sun) and % of backup data to re-read.
CHECK_WEEKDAY=7
CHECK_READ_PERCENT=5
# Optional healthchecks.io-style URL, e.g. https://hc-ping.com/<uuid>
HEALTHCHECK_URL=

# 1 = also run a backup every time the container starts.
BACKUP_ON_START=0
# 1 = allow creating the sync into a non-empty local folder (merges local files UP to MEGA!).
ALLOW_NONEMPTY_INIT=0

# Web UI port on this machine: http://<host>:2947
WEB_PORT=2947
# Password for the web UI. If empty, one is generated; read it with:
#   docker exec mega-backup cat /config/app-password
APP_PASSWORD=
